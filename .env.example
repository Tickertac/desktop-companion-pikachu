# Copy this file to .env and fill in the keys.
# What the companion calls you.
COMPANION_USER_NAME=
# Claude API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional here: if blank, the Groq key in ~/.config/watch/.env is used.
GROQ_API_KEY=
# Optional: Spotify app Client ID (see README, Spotify setup).
SPOTIFY_CLIENT_ID=
